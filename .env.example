# Copia a .env. Valores literales: sin comillas, espacios ni interpolaciones.
COMPOSE_PROJECT_NAME=srpolvoron-media
TZ=Europe/Madrid
# UID/GID de tu usuario Debian: id -u; id -g. Todos los procesos usan este usuario.
PUID=1000
PGID=1000
APPDATA_ROOT=/srv/jellyfin-home/appdata
DATA_ROOT=/srv/media
# Debe coincidir con SHARED_NETWORK del proyecto docker-qbittorrent.
SHARED_NETWORK=media-downloads

# Estas IP son un EJEMPLO de túnel. Ajústalas a tu WireGuard real.
HOME_WG_IP=10.77.0.2
OVH_WG_IP=10.77.0.1
WG_INTERFACE=wg-media
JELLYFIN_DOMAIN=cine.example.com
SEERR_DOMAIN=peticiones.example.com

# Solo se usan para resolver imágenes con ./stack lock.
# El arranque usa digests inmutables de images.lock.env, nunca estos canales.
JELLYFIN_SOURCE_IMAGE=jellyfin/jellyfin:latest
SEERR_SOURCE_IMAGE=ghcr.io/seerr-team/seerr:latest
RADARR_SOURCE_IMAGE=lscr.io/linuxserver/radarr:latest
SONARR_SOURCE_IMAGE=lscr.io/linuxserver/sonarr:latest
PROWLARR_SOURCE_IMAGE=lscr.io/linuxserver/prowlarr:latest
BAZARR_SOURCE_IMAGE=lscr.io/linuxserver/bazarr:latest
TRAEFIK_SOURCE_IMAGE=traefik:v3

# Traefik EXISTENTE en OVH: ajusta los nombres a su configuración estática.
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Solo para el Traefik opcional incluido (no instales otro si ya tienes uno).
ACME_EMAIL=admin@example.com
# Opcional: descomenta y pon el GID real para ./stack up --intel.
# RENDER_GID=109
